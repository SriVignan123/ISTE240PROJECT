<!DOCTYPE html>
<html>
<head>
    <title>Add Enrollment</title>
</head>
<body>
<h2>Enroll a Student in a Course</h2>
<form action="/enrollments/add" method="post">
    <div>
        <label>Enrollment ID:</label>
        <input type="number" name="id" required>
    </div>
    <div>
        <label>Student ID:</label>
        <input type="text" name="studentID" required>
    </div>
    <div>
        <label>Course ID:</label>
        <input type="text" name="courseID" required>
    </div>
    <div>
        <label>Date:</label>
        <input type="text" name="enrollmentDate" placeholder="YYYY-MM-DD">
    </div>
    <div>
        <label>Grade:</label>
        <input type="text" name="grade">
    </div>
    <br>
    <button type="submit">Submit Enrollment</button>
</form>
<br>
<a href="/enrollments">Back to List</a> | <a href="/">Back to Home</a>
</body>
</html>